# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-local-supabase-publishable-key"

# Server Secret Key (Strictly hidden from client code)
# NEVER import or export this into client-side React components.
SUPABASE_SECRET_KEY="your-local-supabase-secret-key"

# AI provider — if absent, NOVA uses the deterministic MockProvider for local development/tests.
ANTHROPIC_API_KEY=""

# Optional email delivery through Resend. If absent, the durable email outbox stays pending.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="NOVA <noreply@example.com>"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
