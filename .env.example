# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-local-supabase-publishable-key"

# Server Secret Key (Strictly hidden from client code)
# NEVER import or export this into client-side react components.
# This must not be used in standard query execution.
SUPABASE_SECRET_KEY="your-local-supabase-secret-key"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider Credentials (OpenRouter / Anthropic / OpenAI / Gemini)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="z-ai/glm-5.2:free"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Dedicated Sandbox Worker Configuration (Phases 3A - 3H)
# Leave unset in local dev to default to DeterministicMockRunner
NOVA_SANDBOX_WORKER_URL="https://sandbox-worker.internal.nova.platform/v1/execute"
NOVA_WORKER_SECRET="your-service-to-service-hmac-shared-secret"

# Sandbox Backend Execution Engine ('mock' | 'modal')
SANDBOX_BACKEND="mock"

# Modal Cloud Sandbox Hypervisor Credentials (Required only if SANDBOX_BACKEND="modal")
MODAL_TOKEN_ID="your-modal-token-id"
MODAL_TOKEN_SECRET="your-modal-token-secret"
MODAL_ENVIRONMENT="main"
MODAL_APP_NAME="nova-internship-mentor"
